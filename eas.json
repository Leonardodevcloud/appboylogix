{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "channel": "production"
    },

    "ig": {
      "extends": "preview",
      "channel": "ig",
      "env": { "MARCA": "ig" },
      "android": { "buildType": "apk" }
    },
    "ig-loja": {
      "extends": "production",
      "channel": "ig",
      "env": { "MARCA": "ig" }
    },

    "cliente-exemplo": {
      "extends": "preview",
      "channel": "cliente-exemplo",
      "env": { "MARCA": "cliente-exemplo" },
      "android": { "buildType": "apk" }
    },
    "cliente-exemplo-loja": {
      "extends": "production",
      "channel": "cliente-exemplo",
      "env": { "MARCA": "cliente-exemplo" }
    }
  },
  "submit": {
    "production": {}
  }
}
